# 복사해서 .env로 쓰고 값을 채우세요. .env는 커밋하지 않습니다(.gitignore에 있음).
# 전체 목록은 앱 레포 docs/infra/.env.example 에 있습니다.

# 카카오 로컬 API (장소 종류). 비우면 제목 키워드로만 자리를 정합니다.
KAKAO_REST_API_KEY=

# DB (PostgreSQL). 비우면 메모리 DB(H2)로 뜹니다(껐다 켜면 일정이 사라짐).
# 예: jdbc:postgresql://localhost:5432/fashion  (schedule 스키마를 만들어 두세요)
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
